      <CommandLineArguments>
         <!-- Off by default. It was on while the 理解マップ had no API behind
              it; now that 数学 runs on published courses and the authored
              prerequisite graph, leaving it on means every run from Xcode shows
              invented data instead of the thing being built.

              Tick it in Edit Scheme › Run › Arguments to compare against the
              design fixtures. Debug builds only; compiled out of Release. -->
         <CommandLineArgument
            argument = "-useSampleData"
            isEnabled = "NO">
